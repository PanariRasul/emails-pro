# Copy to backend/.env for local development. On Render, set these in the service's Environment tab instead.
# Never commit the real .env file.

DATABASE_URL="postgresql://user:password@localhost:5432/emailspro"
DIRECT_URL="postgresql://user:password@localhost:5432/emailspro"

JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"
ENCRYPTION_KEY=""            # openssl rand -base64 32  (back it up!)
CORS_ORIGINS="http://localhost:5173"
PUBLIC_API_URL="http://localhost:10000"
APP_URL="http://localhost:5173"

BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMe-Admin-123"

# --- Login OTP / password-reset mailbox ---
# Gmail: enable 2-Step Verification, then create an App Password (16 characters).
# NOTE: Render Free blocks SMTP ports. On Render, connect the mailbox with Google instead
# (Admin → Policies & settings → Login security → Connect with Google).
SYSTEM_MAIL_USER="emailspro.otp@gmail.com"
SYSTEM_MAIL_APP_PASSWORD=""
# SYSTEM_MAIL_HOST="smtp.gmail.com"
# SYSTEM_MAIL_PORT=465

# --- Optional: Google (Gmail API sending, OTP mailbox, "Continue with Google") ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# --- Optional: "Continue with Microsoft" ---
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT="common"
